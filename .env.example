# ──────────────────────────────────────────────────────────────────────────
# MediSeg 환경변수 설정 템플릿
# 이 파일을 .env 로 복사한 뒤 실제 값을 입력하세요.
# .env 파일은 절대 Git에 커밋하지 마세요! (.gitignore에 포함되어야 합니다)
# ──────────────────────────────────────────────────────────────────────────

# [필수] Hugging Face API 키
# 발급: https://huggingface.co/settings/tokens
# 권한: Inference API Read 이상
VITE_HF_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# [선택] 사용할 HF 모델 엔드포인트
# 기본값: 아래 예시 URL (실제 배포 모델로 교체 필요)
# 권장 모델: Project-MONAI/whole_body_CT_segmentation
VITE_HF_MODEL_URL=https://api-inference.huggingface.co/models/YOUR_ORG/medical-segmentation-3d

# [참고] Vite 환경변수는 VITE_ 접두사가 필수입니다.
# import.meta.env.VITE_HF_API_KEY 로 접근합니다.
