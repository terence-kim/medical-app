<UserControl x:Class="MediSeg.WPF.Controls.Viewer3DControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0d0d0d">
    <Grid>
        <!-- WPF 내장 3D 뷰포트 -->
        <Viewport3D x:Name="Viewport"
                    MouseDown="Viewport_MouseDown"
                    MouseMove="Viewport_MouseMove"
                    MouseUp="Viewport_MouseUp"
                    MouseWheel="Viewport_MouseWheel">

            <!-- 카메라 -->
            <Viewport3D.Camera>
                <PerspectiveCamera x:Name="Camera"
                                   Position="300,300,600"
                                   LookDirection="-1,-1,-2"
                                   UpDirection="0,1,0"
                                   FieldOfView="45"/>
            </Viewport3D.Camera>

            <!-- 조명 -->
            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <Model3DGroup>
                        <AmbientLight Color="#444444"/>
                        <DirectionalLight Color="White" Direction="-1,-1,-1"/>
                        <DirectionalLight Color="#888888" Direction="1,0.5,0.5"/>
                    </Model3DGroup>
                </ModelVisual3D.Content>
            </ModelVisual3D>

            <!-- 3D 모델 컨테이너 -->
            <ModelVisual3D x:Name="ModelContainer"/>
        </Viewport3D>

        <!-- 빈 상태 메시지 -->
        <StackPanel x:Name="EmptyState3D"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="Visible" IsHitTestVisible="False">
            <TextBlock Text="🫁" FontSize="36" HorizontalAlignment="Center"
                       Foreground="#334155"/>
            <TextBlock Text="Generate 3D 버튼으로 3D 모델 생성"
                       Foreground="#475569" FontSize="12" Margin="0,8,0,0"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="마우스 좌클릭: 회전  |  스크롤: 줌  |  우클릭: 팬"
                       Foreground="#334155" FontSize="10" Margin="0,4,0,0"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- 생성 중 오버레이 -->
        <Grid x:Name="GeneratingOverlay" Visibility="Collapsed">
            <Rectangle Fill="#cc0d0d0d"/>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="3D 메쉬 생성 중..." Foreground="#94a3b8"
                           HorizontalAlignment="Center" FontSize="13"/>
                <ProgressBar IsIndeterminate="True" Width="200" Height="4"
                             Foreground="#3b82f6" Background="#1e1e38"
                             Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>

        <!-- 하단 조작 힌트 -->
        <Border VerticalAlignment="Bottom" HorizontalAlignment="Left"
                Background="#aa0d0d0d" Padding="8,4" Margin="0,0,0,0"
                IsHitTestVisible="False">
            <TextBlock Text="🖱 좌클릭 회전 · 스크롤 줌 · 우클릭 팬"
                       Foreground="#334155" FontSize="9"/>
        </Border>

        <!-- 범례 -->
        <ItemsControl x:Name="LegendItems"
                      VerticalAlignment="Bottom" HorizontalAlignment="Right"
                      Margin="0,0,8,8" IsHitTestVisible="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,1">
                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2"
                                   Fill="{Binding ColorBrush}" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding Label}"
                                   Foreground="#94a3b8" FontSize="10"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
